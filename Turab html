<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>TURAVOZ Account</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#090909;color:#fff;font-family:Arial,sans-serif}
.wrap{max-width:850px;margin:auto;padding:25px 18px}.logo{font-size:30px;font-weight:900;letter-spacing:3px}.logo b{color:#ddb43f}
.back{display:block;color:#aaa;text-decoration:none;margin:18px 0 30px}.hero{text-align:center;margin-bottom:25px}
.hero h1{font-size:36px;margin:0 0 8px}.hero p{color:#aaa}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.card{background:#151515;border:1px solid #292929;border-radius:20px;padding:24px}
.tabs{display:flex;gap:8px}.tabs button{width:50%;margin:0}
button{border:0;border-radius:11px;padding:14px;background:#ddb43f;color:#111;font-weight:bold;font-size:16px;cursor:pointer}
.tabs button:not(.active),.logout{background:#292929;color:#fff}label{display:block;color:#bbb;margin:15px 0 7px}
input{width:100%;padding:14px;border-radius:10px;border:1px solid #3a3a3a;background:#0c0c0c;color:#fff;font-size:15px}
form button{width:100%;margin-top:18px}.msg{display:none;margin-top:15px;padding:12px;background:#252525;border-radius:10px;color:#ddd}
.row{display:flex;justify-content:space-between;padding:16px 0;border-bottom:1px solid #292929;color:#aaa}.row strong{color:#fff}
#signup{display:none}.dash{display:none;text-align:center}.avatar{font-size:40px;margin:10px}
@media(max-width:650px){.grid{grid-template-columns:1fr}.hero h1{font-size:30px}}
</style>
</head>
<body>
<div class="wrap">
<div class="logo"><b>TURA</b>VOZ</div>
<a class="back" href="index.html">← Back to TURAVOZ</a>
<div class="hero"><h1 id="heading">TURAVOZ Account</h1><p>Login or create your account.</p></div>

<div id="auth" class="grid">
<div class="card">
<div class="tabs"><button id="lt" class="active" onclick="loginTab()">Login</button><button id="st" onclick="signupTab()">Signup</button></div>
<form id="login" onsubmit="doLogin(event)">
<label>Email</label><input id="le" type="email" required placeholder="you@example.com">
<label>Password</label><input id="lp" type="password" required placeholder="Password">
<button>Login</button></form>
<form id="signup" onsubmit="doSignup(event)">
<label>Full name</label><input id="sn" required placeholder="Your name">
<label>Email</label><input id="se" type="email" required placeholder="you@example.com">
<label>Password</label><input id="sp" type="password" minlength="6" required placeholder="At least 6 characters">
<button>Create Account</button></form>
<div id="msg" class="msg"></div>
</div>
<div class="card"><h2>Account Benefits</h2>
<div class="row"><span>Orders</span><strong>Track orders</strong></div>
<div class="row"><span>Shopping</span><strong>Save details</strong></div>
<div class="row"><span>Seller</span><strong>Seller account</strong></div>
</div>
</div>

<div id="dash" class="card dash">
<div class="avatar">👤</div><h2>Welcome, <span id="name"></span>!</h2><p id="email" style="color:#aaa"></p>
<div class="row"><span>Orders</span><strong>0 orders</strong></div>
<div class="row"><span>Seller Account</span><strong>Not activated</strong></div>
<button class="logout" onclick="logout()" style="width:100%;margin-top:20px">Logout</button>
</div>
</div>
<script>
const K="turavoz_account";
function show(m){msg.textContent=m;msg.style.display="block"}
function loginTab(){login.style.display="block";signup.style.display="none";lt.className="active";st.className=""}
function signupTab(){login.style.display="none";signup.style.display="block";lt.className="";st.className="active"}
function doSignup(e){e.preventDefault();localStorage.setItem(K,JSON.stringify({name:sn.value,email:se.value.toLowerCase(),password:sp.value}));loginTab();show("Account created. Now login.");e.target.reset()}
function doLogin(e){e.preventDefault();let a=JSON.parse(localStorage.getItem(K)||"null");if(!a)return show("Please Signup first.");if(a.email!==le.value.toLowerCase()||a.password!==lp.value)return show("Incorrect email or password.");localStorage.setItem(K+"_in","1");render(a)}
function render(a){auth.style.display="none";dash.style.display="block";heading.textContent="My Account";name.textContent=a.name;email.textContent=a.email}
function logout(){localStorage.removeItem(K+"_in");location.reload()}
let a=JSON.parse(localStorage.getItem(K)||"null");if(a&&localStorage.getItem(K+"_in")==="1")render(a);
</script>
</body></html>
